# Cole no Environment do app BACKEND no Dokploy (domínio backlmbot).
# Container Port do domínio = 3001

NODE_ENV=production
API_PORT=3001
RUNNING_IN_DOCKER=1
SKIP_MIGRATIONS=true
MANAGER_CAN_SPAWN_WORKERS=false
MANAGER_VNC_ENABLED=false

# JWT — mínimo 32 caracteres
JWT_SECRET=altere-este-segredo-com-pelo-menos-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1h
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=admin12345

# CORS do painel público
API_CORS_ORIGINS=https://rdofertas.simplapp.com.br

# MySQL do Dokploy (hostname interno do serviço de banco)
MYSQL_USER=radar
MYSQL_PASSWORD=troque-esta-senha
MYSQL_DATABASE=radar_ofertas
MYSQL_PORT=3306
MYSQL_DOCKER_HOST=nome-interno-do-mysql

# Redis do Dokploy (hostname interno)
REDIS_ENABLED=true
REDIS_URL=redis://nome-interno-do-redis:6379
REDIS_DOCKER_HOST=nome-interno-do-redis

APP_TIMEZONE=America/Sao_Paulo
