# Cole no Environment do app BACKEND no Dokploy (domínio backlmbot).
# NÃO cole a .env do PC — localhost e porta 3360 só funcionam na sua máquina.
# Container Port do domínio = 3001
#
# No painel do MySQL/Redis, copie o Internal Host (não External, não localhost).
# Porta interna do MySQL no Docker = 3306 (3360 é mapeamento no seu PC).

NODE_ENV=production
APP_TIMEZONE=America/Sao_Paulo
API_PORT=3001
RUNNING_IN_DOCKER=1
SKIP_MIGRATIONS=true
MANAGER_CAN_SPAWN_WORKERS=false
MANAGER_VNC_ENABLED=false

JWT_SECRET=gere-um-segredo-com-pelo-menos-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1h
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=admin12345
API_CORS_ORIGINS=https://rdofertas.simplapp.com.br

# Mesmo banco (ex.: ml-link02). Host = Internal Host do serviço MySQL no Dokploy.
MYSQL_USER=mix-s-db-link02
MYSQL_PASSWORD=a-mesma-senha-do-banco
MYSQL_DATABASE=ml-db-link-banco
MYSQL_PORT=3306
MYSQL_DOCKER_HOST=COLE-O-INTERNAL-HOST-DO-MYSQL

# Redis precisa ser um serviço no Dokploy (não localhost).
REDIS_ENABLED=true
REDIS_URL=redis://COLE-O-INTERNAL-HOST-DO-REDIS:6379
REDIS_DOCKER_HOST=COLE-O-INTERNAL-HOST-DO-REDIS

WHATSAPP_AUTH_PATH=/app/data/auth_info_baileys
ML_AUTH_PATH=/app/data/ml_auth
